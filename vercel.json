{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "src/migrations/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!_vercel/).*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "0 5 * * *"
    }
  ]
}
