# --- Core ---
PORT=3000
PUBLIC_URL=http://localhost:3000
NODE_ENV=development            # 'production' makes the session cookie Secure (serve over HTTPS)
PAIRPLUG_DB=./data/pairplug.db
PAIRPLUG_UPLOADS=./data/uploads

# --- Payments (pick ONE; with neither set, checkout is disabled and says so) ---
# Real provider: Stripe (test-mode keys first!). Webhook endpoint: POST {PUBLIC_URL}/webhooks/payments/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Development-only simulator (no money moves; uses the same signed-webhook path):
PAYMENTS_MODE=sandbox
SANDBOX_WEBHOOK_SECRET=change-me-in-dev

# --- Tax (flat estimate; 0 = no tax charged). 825 = 8.25% ---
TAX_RATE_BPS=0

# --- Shipping ---
SHIPPO_API_KEY=                 # label purchase is NOT implemented yet; setting this only changes the dashboard hint
CARRIER_WEBHOOK_SECRET=         # shared secret for POST /webhooks/tracking (set to enable delivery sync)
