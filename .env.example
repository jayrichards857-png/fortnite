# Copy to /etc/pairplug.env (see deploy/pairplug.env.example) or export these in your shell. Never commit real values.
# FORMAT: KEY=VALUE per line; comments on their OWN lines only (no trailing "# ..." after a value).

# ---- Private beta (direct checkout: sellers are paid through their own Stripe Payment Links) ----
PORT=3000
PUBLIC_URL=http://localhost:3000
# development | production. Production => Secure cookies, HSTS, loopback-only bind, invite-only sellers by default, and the server refuses unsafe settings.
NODE_ENV=development
# external (default) = PairPlug never holds buyer money.
CHECKOUT_MODE=external
DATABASE_URL=postgres://pairplug:CHANGE-ME@127.0.0.1:5432/pairplug
PAIRPLUG_UPLOADS=./data/uploads
# Behind a reverse proxy on the same host use loopback; on other platforms use a hop count such as 1.
TRUST_PROXY=loopback
# invite (default) = admin-issued invitations, hard cap of 3 sellers. `open` is for local experiments only and is refused in production.
SELLER_ONBOARDING=invite
# open (default) = anyone can create a BUYER account. closed = pause buyer sign-up ("Coming soon").
SIGNUPS=open
PUBLIC_RELEASE_DATE=2026-11-01
# none | resend
EMAIL_PROVIDER=none
# EMAIL_FROM=
# EMAIL_API_KEY=
# PAYMENT_LINK_HOSTS=buy.stripe.com
# Shippo shipping labels, TEST MODE ONLY. Put a Shippo TEST token here (starts with shippo_test_) in your own local environment; never commit it, never paste it into chat.
# Live tokens (shippo_live_...) are recognised and refused. The server refuses to start in production if this is set. See docs/SHIPPING.md.
# SHIPPO_API_KEY=
# Optional shared secret for POST /webhooks/tracking
CARRIER_WEBHOOK_SECRET=

# ---- Optional business identity shown on the legal pages (leave blank until real; PairPlug never invents these) ----
# LEGAL_ENTITY=
# LEGAL_ADDRESS=

# ---- LEGACY platform mode (PairPlug-held escrow). NOT used in the beta; kept for history/tests. ----
# CHECKOUT_MODE=platform
# PAYMENTS_MODE=sandbox
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# TAX_RATE_BPS=0
