# Copy to /etc/pairplug.env (see deploy/pairplug.env.example) or export these in your shell. Never commit real values.
# ---- Private beta (direct checkout: sellers are paid through their own Stripe Payment Links) ----
PORT=3000
PUBLIC_URL=http://localhost:3000
NODE_ENV=development            # 'production' => Secure cookies, HSTS, and the server refuses unsafe settings
CHECKOUT_MODE=external          # default. PairPlug never holds buyer money in this mode
PAIRPLUG_DB=./data/pairplug.db
PAIRPLUG_UPLOADS=./data/uploads
TRUST_PROXY=loopback            # behind a reverse proxy on the same host. Use a hop count (e.g. 1) on other platforms
SELLER_ONBOARDING=open          # 'invite' = only SELLER_ALLOWED_EMAILS may open a store (recommended for the beta)
SELLER_ALLOWED_EMAILS=
# PAYMENT_LINK_HOSTS=buy.stripe.com
# ---- Optional: chat transport ----
CARRIER_WEBHOOK_SECRET=         # shared secret for POST /webhooks/tracking (not required)

# ---- LEGACY platform mode (PairPlug-held escrow). NOT used in the beta; kept for history/tests. ----
# CHECKOUT_MODE=platform
# PAYMENTS_MODE=sandbox         # simulator: development ONLY, refused in production
# STRIPE_SECRET_KEY=            # unverified adapter, see README
# STRIPE_WEBHOOK_SECRET=
# TAX_RATE_BPS=0
