{
  "name": "pairplug",
  "version": "1.0.0",
  "description": "PairPlug - clothing marketplace (private beta) on Node.js + PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "PAYMENTS_MODE=sandbox node --watch src/server.js",
    "test": "node scripts/run-tests.js",
    "check": "node scripts/check.js",
    "audit:mobile": "node scripts/mobile-audit.js",
    "create-admin": "node scripts/create-admin.js",
    "admin:status": "node scripts/create-admin.js status",
    "admin:setup": "node scripts/create-admin.js setup",
    "admin:reset": "node scripts/create-admin.js reset",
    "seed:demo": "node scripts/seed-demo.js",
    "screenshots": "node scripts/screenshots.js",
    "test:browser": "node scripts/browser-journey.js && node scripts/browser-chat.js && node scripts/browser-beta.js && node scripts/browser-final.js && node scripts/browser-shipping.js && node scripts/browser-reviews.js && node scripts/browser-mobile.js",
    "sandbox:shipping": "node scripts/shipping-sandbox.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "inventory:sellers": "node scripts/inventory-sellers.js",
    "start:beta": "NODE_ENV=production CHECKOUT_MODE=external node src/server.js",
    "test:pg:start": "scripts/pg-test.sh start",
    "test:pg:stop": "scripts/pg-test.sh stop",
    "db:import-sqlite": "node scripts/sqlite-to-pg.js",
    "db:schema": "node scripts/dump-schema.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayrichards857-png/fortnite.git"
  },
  "bugs": {
    "url": "https://github.com/jayrichards857-png/fortnite/issues"
  },
  "homepage": "https://github.com/jayrichards857-png/fortnite#readme",
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "playwright-core": "1.54"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
