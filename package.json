{
  "name": "pairplug",
  "version": "1.0.0",
  "description": "PairPlug - secondhand marketplace for North America with escrow and a reseller dashboard",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "PAYMENTS_MODE=sandbox node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "create-admin": "node scripts/create-admin.js",
    "seed:demo": "node scripts/seed-demo.js",
    "screenshots": "node scripts/screenshots.js",
    "test:browser": "node scripts/browser-journey.js && node scripts/browser-chat.js && node scripts/browser-beta.js && node scripts/browser-final.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "inventory:sellers": "node scripts/inventory-sellers.js",
    "start:beta": "NODE_ENV=production CHECKOUT_MODE=external node src/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayrichards857-png/fortnite.git"
  },
  "bugs": {
    "url": "https://github.com/jayrichards857-png/fortnite/issues"
  },
  "homepage": "https://github.com/jayrichards857-png/fortnite#readme",
  "dependencies": {
    "express": "^4.22.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "playwright-core": "1.54"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}