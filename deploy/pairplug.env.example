# /etc/pairplug.env
# FORMAT RULES (systemd EnvironmentFile): one KEY=VALUE per line, NO trailing "# comments" after a value, no quotes needed.
# Comments go on their own line, like this one. The app refuses to start in production if a value contains " #".
# There are NO secrets in the beta configuration (no payment keys). Never commit a real copy of this file.

NODE_ENV=production
PORT=3000

# Must be the public https:// address of the site; the server refuses to start otherwise.
PUBLIC_URL=https://YOUR-SITE-ADDRESS

# Seller-direct checkout: PairPlug holds no money.
CHECKOUT_MODE=external

PAIRPLUG_DB=/var/lib/pairplug/pairplug.db
PAIRPLUG_UPLOADS=/var/lib/pairplug/uploads

# Caddy runs on the same machine, so trust only loopback. The app itself listens on 127.0.0.1 only (set HOST=0.0.0.0 only if you know why).
TRUST_PROXY=loopback

# invite = only the emails below can open a store (this is also the production default). open = anyone can.
SELLER_ONBOARDING=invite

# Comma-separated, no spaces required. The founding reseller's account email.
SELLER_ALLOWED_EMAILS=partner@example.com

# Do NOT set PAYMENTS_MODE (the payment simulator is refused in production) or RATE_LIMIT_SCALE.
