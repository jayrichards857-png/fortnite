# /etc/pairplug.env  — copy, edit, then: chmod 600 /etc/pairplug.env.   There are NO secrets in the beta configuration
# (no payment keys: sellers are paid through their own Stripe links). Never commit this file.
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://YOUR-SITE-ADDRESS            # must be https:// — the server refuses to start otherwise
CHECKOUT_MODE=external                           # seller-direct checkout; PairPlug holds no money
PAIRPLUG_DB=/var/lib/pairplug/pairplug.db
PAIRPLUG_UPLOADS=/var/lib/pairplug/uploads
TRUST_PROXY=loopback                             # Caddy runs on the same machine
SELLER_ONBOARDING=invite                         # only the emails below can open a store
SELLER_ALLOWED_EMAILS=partner@example.com        # comma-separated; the founding reseller's account email
# PAYMENT_LINK_HOSTS=buy.stripe.com              # default; add hosts only deliberately
# Do NOT set PAYMENTS_MODE (sandbox is refused in production) or RATE_LIMIT_SCALE.
