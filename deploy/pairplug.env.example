# /etc/pairplug.env
# FORMAT RULES (systemd EnvironmentFile): one KEY=VALUE per line, NO trailing "# comments" after a value, no quotes needed.
# Comments go on their own line, like this one. The app refuses to start in production if a value contains " #".
# The only secret in the beta configuration is the database password inside DATABASE_URL (there are no payment keys). Keep this file chmod 640 root:pairplug and never commit a real copy of it.

NODE_ENV=production
PORT=3000

# Must be the public https:// address of the site; the server refuses to start otherwise.
PUBLIC_URL=https://YOUR-SITE-ADDRESS

# Seller-direct checkout: Grailedside holds no money.
CHECKOUT_MODE=external

# PostgreSQL connection (the only database). Local server: postgres://pairplug:PASSWORD@127.0.0.1:5432/pairplug
# A managed database over the network MUST use TLS: add ?sslmode=require to the URL or set DATABASE_SSL=1 (the server refuses to start otherwise).
DATABASE_URL=postgres://pairplug:CHANGE-ME@127.0.0.1:5432/pairplug
# Optional pool/timeouts: PGPOOL_MAX=10  PG_STATEMENT_TIMEOUT_MS=20000
# Uploaded product photos are still FILES on this machine (not in the database): this directory MUST be on persistent storage and be backed up.
PAIRPLUG_UPLOADS=/var/lib/pairplug/uploads

# Caddy runs on the same machine, so trust only loopback. The app itself listens on 127.0.0.1 only (set HOST=0.0.0.0 only if you know why).
TRUST_PROXY=loopback

# invite = stores are opened only through admin-issued invitations, max 3 sellers (production default). Never use open in production.
SELLER_ONBOARDING=invite

# open (default) = anyone can create a BUYER account; sellers are invitation-only regardless. closed = pause buyer sign-up as well ("Coming soon").
SIGNUPS=open

# The date shown as "Selling available <date>". YYYY-MM-DD. CONFIRM THIS DATE BEFORE LAUNCH (the value below is a placeholder).
PUBLIC_RELEASE_DATE=2026-11-01

# Email delivery: none (default; messages are only recorded in the admin outbox) or resend (needs the two values below). Unverified live.
# BEFORE inviting the first reseller: create a Resend account, verify your sending domain (SPF/DKIM), set EMAIL_PROVIDER=resend, EMAIL_FROM and EMAIL_API_KEY, restart,
# then use Account -> Send verification email on a test address and confirm it really arrives. Until then verification links are handed over from Admin -> Email outbox.
EMAIL_PROVIDER=none
# EMAIL_FROM=Grailedside <hello@your-domain.example>
# EMAIL_API_KEY goes in the file ONLY if you enable resend (keep the file chmod 640 root:pairplug). Never commit it.

# Optional: shown on /support so people can email you. Leave unset to show no address.
# Optional. Defaults to the official address pairplugservice@gmail.com (used by every page). Set this ONLY to deliberately replace it; the server logs a notice at startup when you do.
# SUPPORT_EMAIL=pairplugservice@gmail.com

# Do NOT set SHIPPO_API_KEY here: shipping labels are test-mode only in this release and the server refuses to start in production with it set (docs/SHIPPING.md).
# Do NOT set PAYMENTS_MODE (the payment simulator is refused in production) or RATE_LIMIT_SCALE.

# Payment-link policy. PAYMENT_LINK_HOSTS can only NARROW the approved Stripe host list (default buy.stripe.com); it cannot add other providers.
# MAX_SUSPENSION_DAYS caps temporary selling suspensions staff may apply (default 5, ceiling 30).
# MAX_SUSPENSION_DAYS=5
