# Vercel environment variable NAMES with placeholder values. Set the real values in the Vercel dashboard (Settings -> Environment Variables),
# scoped per environment (Production / Preview). Never commit real values. See docs/VERCEL.md.
NODE_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@POOLED-HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@DIRECT-HOST/DB?sslmode=require     # only for `npm run migrate`
PAIRPLUG_DB_LABEL=production            # "preview" in the Preview environment; must equal VERCEL_ENV
PUBLIC_URL=https://YOUR-DOMAIN
CHECKOUT_MODE=external
SELLER_ONBOARDING=invite
TRUST_PROXY=1
CRON_SECRET=GENERATE-32-OR-MORE-RANDOM-CHARACTERS
S3_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
S3_BUCKET=pairplug-uploads
S3_REGION=auto
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
EMAIL_PROVIDER=resend
EMAIL_API_KEY=...
EMAIL_FROM=Grailedside <hello@YOUR-DOMAIN>
SIGNUPS=open
